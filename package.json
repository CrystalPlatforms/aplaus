{
	"name": "aplaus",
	"version": "0.0.0",
	"description": "",
	"scripts": {
		"prepare": "simple-git-hooks",
		"setup": "pnpm i",
		"dev:data-service": "pnpm run --filter data-service dev",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"lint:ci": "biome ci .",
		"check:docs": "tsx scripts/doc-drift.ts",
		"check:runtime-types": "tsx scripts/runtime-types-drift.ts",
		"types": "pnpm run --filter @repo/librus-client types && pnpm run --filter data-service types && pnpm run --filter web types",
		"init-project": "tsx scripts/init-project.ts",
		"knip": "knip",
		"deps": "taze -r",
		"deps:update": "taze -r -w",
		"deps:major": "taze -r major",
		"deps:major:update": "taze -r major -w",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"release": "semantic-release",
		"release:dry": "semantic-release --dry-run",
		"dev:web": "pnpm run --filter web dev"
	},
	"keywords": [],
	"author": "",
	"license": "MIT",
	"packageManager": "pnpm@12.9.1",
	"devDependencies": {
		"@biomejs/biome": "2.4.4",
		"@semantic-release/changelog": "^6.0.3",
		"@semantic-release/git": "^10.0.1",
		"@types/node": "^22.20.5",
		"@vitest/coverage-v8": "^4.1.11",
		"js-yaml": "^5.4.2",
		"jsdom": "^27.0.0",
		"knip": "^6.39.0",
		"semantic-release": "^25.0.9",
		"simple-git-hooks": "^2.14.0",
		"taze": "^19.17.2",
		"tsx": "^4.23.15",
		"typescript": "^5.9.3",
		"vitest": "^4.1.11"
	},
	"simple-git-hooks": {
		"pre-commit": "pnpm run lint:ci",
		"pre-push": "pnpm run types && pnpm run knip"
	},
	"allowScripts": {
		"esbuild@0.28.2": true,
		"fsevents@2.3.3": true,
		"simple-git-hooks@2.14.0": true
	}
}
