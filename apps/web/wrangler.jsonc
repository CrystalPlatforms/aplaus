{
	"$schema": "./node_modules/wrangler/config-schema.json",
	// The PWA as an assets-only Worker — the current Cloudflare Pages is part of
	// Workers, so deploys go through `wrangler deploy` (CI web job), which owns
	// https://aplaus-web.crs-studio.workers.dev.
	"name": "aplaus-web",
	"compatibility_date": "2026-10-07",
	"workers_dev": true,
	"assets": {
		// Vite's build output (apps/web/dist). Deep links fall back to index.html
		// so the pushState router can own every path.
		"directory": "./dist",
		"not_found_handling": "single-page-application"
	}
}
