{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "aplaus-ds",
	"main": "./src/index.ts",
	"compatibility_date": "2026-10-07",
	"compatibility_flags": ["nodejs_compat"],
	// Ship source maps with every version so the stack traces in Workers Logs and
	// traces point at TypeScript source instead of minified bundle output.
	// Inherited by every environment below.
	"upload_source_maps": true,
	"observability": {
		// Workers Logs: 100% sampling initially so we see every event while traffic is low.
		// Dial down to ~0.1 (10%) once volume becomes expensive — pricing kicks in past the
		// free tier of 200k events/day. Ref: https://developers.cloudflare.com/workers/platform/pricing/#workers-logs
		"logs": {
			"enabled": true,
			"head_sampling_rate": 1
		},
		// Distributed traces sample at 1% — traces are far more expensive per event than logs.
		// Bump temporarily (e.g. 0.1) when actively debugging latency or fan-out issues.
		"traces": {
			"enabled": true,
			"head_sampling_rate": 0.01
		}
	},
	"env": {
		/**
		 * Local / Development environment
		 */
		"dev": {
			"name": "aplaus-ds-dev",
			// Poll every 5 minutes (phase 12): the cron diffs the 8 tracked
			// resources per account and sends web push on changes.
			"triggers": { "crons": ["*/5 * * * *"] },
			"vars": {
				"CLOUDFLARE_ENV": "dev",
				// Local development uses a fixed localhost allowlist, so this stays empty.
				"ALLOWED_ORIGINS": ""
			},
			"ratelimits": [
				{
					"name": "RATE_LIMIT_AUTH",
					"namespace_id": "1001",
					"simple": { "limit": 20, "period": 60 }
				},
				// Sized for uptime monitors, not humans. A monitoring provider polls from
				// many checkpoints behind a handful of egress addresses, so an entire
				// provider can reach the Worker as one client address. A human-sized limit
				// here turns routine monitoring into false alerts. 5/s still caps a single
				// address far below anything that would stress KV behind /ready.
				{
					"name": "RATE_LIMIT_HEALTH",
					"namespace_id": "1002",
					"simple": { "limit": 300, "period": 60 }
				}
			],
			"kv_namespaces": [
				{
					"binding": "KV",
					// Local dev and tests use the workerd KV simulation; this id is
					// consulted only when deploying. Create the namespace once and
					// paste its real id here (see README, "Wdrozenie").
					"id": "00000000000000000000000000000000"
				}
			]
			// "queues": {
			//   "producers": [
			//     {
			//       "queue": "notification-queue",
			//       "binding": "NOTIFICATION_QUEUE"
			//     }
			//   ],
			//   "consumers": [
			//     {
			//       "queue": "notification-queue",
			//       "max_batch_size": 10,
			//       "max_batch_timeout": 5,
			//       "max_retries": 3,
			//       "dead_letter_queue": "notification-dlq"
			//     }
			//   ]
			// }
		},
		/**
		 * Remote / Staging environment
		 */
		"staging": {
			// "routes": [
			//   {
			//     "pattern": "api-staging.YOUR_DOMAIN.COM",
			//     "custom_domain": true
			//   }
			// ],
			"name": "aplaus-ds-staging",
			// Poll every 5 minutes (phase 12): the cron diffs the 8 tracked
			// resources per account and sends web push on changes.
			"triggers": { "crons": ["*/5 * * * *"] },
			"vars": {
				"CLOUDFLARE_ENV": "staging",
				"ALLOWED_ORIGINS": "https://staging.YOUR_DOMAIN.COM"
			},
			"ratelimits": [
				{
					"name": "RATE_LIMIT_AUTH",
					"namespace_id": "2001",
					"simple": { "limit": 20, "period": 60 }
				},
				// Sized for uptime monitors, not humans — see the dev environment above.
				{
					"name": "RATE_LIMIT_HEALTH",
					"namespace_id": "2002",
					"simple": { "limit": 300, "period": 60 }
				}
			],
			"kv_namespaces": [
				{
					"binding": "KV",
					"id": "00000000000000000000000000000000"
				}
			]
			// "queues": {
			//   "producers": [
			//     {
			//       "queue": "notification-queue-stage",
			//       "binding": "NOTIFICATION_QUEUE"
			//     }
			//   ],
			//   "consumers": [
			//     {
			//       "queue": "notification-queue-stage",
			//       "max_batch_size": 10,
			//       "max_batch_timeout": 5,
			//       "max_retries": 3,
			//       "dead_letter_queue": "notification-dlq-stage"
			//     }
			//   ]
			// }
		},
		/**
		 * Remote / Production environment
		 */
		"production": {
			// "routes": [
			//   {
			//     "pattern": "api.YOUR_DOMAIN.COM",
			//     "custom_domain": true
			//   }
			// ],
			"name": "aplaus-ds-production",
			// Poll every 5 minutes (phase 12): the cron diffs the 8 tracked
			// resources per account and sends web push on changes.
			"triggers": { "crons": ["*/5 * * * *"] },
			"vars": {
				"CLOUDFLARE_ENV": "production",
				"ALLOWED_ORIGINS": "https://YOUR_DOMAIN.COM"
			},
			"ratelimits": [
				{
					"name": "RATE_LIMIT_AUTH",
					"namespace_id": "3001",
					"simple": { "limit": 20, "period": 60 }
				},
				// Sized for uptime monitors, not humans — see the dev environment above.
				{
					"name": "RATE_LIMIT_HEALTH",
					"namespace_id": "3002",
					"simple": { "limit": 300, "period": 60 }
				}
			],
			"kv_namespaces": [
				{
					"binding": "KV",
					"id": "00000000000000000000000000000000"
				}
			]
			// "queues": {
			//   "producers": [
			//     {
			//       "queue": "notification-queue-prod",
			//       "binding": "NOTIFICATION_QUEUE"
			//     }
			//   ],
			//   "consumers": [
			//     {
			//       "queue": "notification-queue-prod",
			//       "max_batch_size": 10,
			//       "max_batch_timeout": 5,
			//       "max_retries": 3,
			//       "dead_letter_queue": "notification-dlq-prod"
			//     }
			//   ]
			// }
		}
	}
}
